# ─── LLM APIs ──────────────────────────────────────────────
GEMINI_API_KEY=                        # https://aistudio.google.com/apikey
GROQ_API_KEY=                          # https://console.groq.com (free)

# ─── Supabase ──────────────────────────────────────────────
SUPABASE_URL=                          # Project Settings → API → URL
SUPABASE_SERVICE_KEY=                  # Project Settings → API → service_role key

# ─── Admin Dashboard ───────────────────────────────────────
ADMIN_PASSWORD_HASH=                   # bcrypt hash of your admin password
ADMIN_JWT_SECRET=                      # any random 64-char hex string

# ─── Vercel Cron Security ──────────────────────────────────
CRON_SECRET=                           # any random secret — Vercel sends it as Bearer token

# ─── Twilio WhatsApp ────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
WHATSAPP_TO_NUMBER=                    # your WhatsApp number with country code

# ─── Gmail API ─────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=                    # Set to https://your-app.vercel.app/api/auth/callback
GMAIL_REFRESH_TOKEN=

# ─── App URL ───────────────────────────────────────────────
NEXTAUTH_URL=                          # https://your-app.vercel.app
